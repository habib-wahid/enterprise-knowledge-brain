# Copy to .env and fill in. .env is gitignored and must never be committed.
#
#   cp .env.example .env
#
# Only needed for the LLM anchor proposer and, later, the answer services.
# Everything else — extraction, embedding, retrieval, anchor validation —
# runs entirely locally and needs no credential.


# --- deployment ------------------------------------------------------------
# Only needed where the paths differ from a developer checkout.
# ECK_DB_PATH=/data/knowledge.db        # serve a database built elsewhere
# ECK_SOURCES_ROOT=/srv/estate          # where estate source is mounted, if any
# ECK_CURATED_DIR=/data/curated         # the human decisions — back this up
# ECK_EMBED_MODEL=BAAI/bge-small-en-v1.5
# HF_HOME=/models                       # pre-warmed embedding model cache

# Fetching a private remote on a machine with no keychain (builders, CI).
# ECK_GIT_TOKEN=glpat-...
# ECK_GIT_USER=oauth2
